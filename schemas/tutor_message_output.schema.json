{
  "$defs": {
    "ExpectedResponseType": {
      "enum": [
        "none",
        "free_text",
        "single_choice",
        "multiple_choice"
      ],
      "title": "ExpectedResponseType",
      "type": "string"
    },
    "TutorInteractionType": {
      "enum": [
        "orientation",
        "explanation",
        "guided_question",
        "formal_assessment",
        "hint",
        "feedback",
        "remediation",
        "review",
        "transition",
        "side_answer",
        "recoverable_error"
      ],
      "title": "TutorInteractionType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_response_type": {
      "$ref": "#/$defs/ExpectedResponseType"
    },
    "interaction_type": {
      "$ref": "#/$defs/TutorInteractionType"
    },
    "question_id": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Question Id"
    },
    "quick_replies": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 6,
      "title": "Quick Replies",
      "type": "array"
    },
    "student_message": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Student Message",
      "type": "string"
    }
  },
  "required": [
    "student_message",
    "interaction_type",
    "expected_response_type",
    "question_id",
    "quick_replies"
  ],
  "title": "TutorMessageResult",
  "type": "object"
}
