# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./data/infratutor.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_DEBUG_PANEL=true
# Optional; defaults to the repository curriculum directory.
# CURRICULUM_DIR=./curriculum

# LLM mode: mock | live
LLM_MODE=mock
LLM_PROVIDER=openai
LLM_ASSESSOR_MODEL=
LLM_TEACHER_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Reliability
LLM_TIMEOUT_SECONDS=30
LLM_TRANSPORT_MAX_RETRIES=1
LLM_REPAIR_RETRIES=1
LOG_LEVEL=INFO
